# انسخ هذا الملف باسم .env واملأ القيم الفعلية - لا ترفع .env على git أبداً

# مفتاح Gemini API (سيُستخدم في المرحلة القادمة - AI)
GEMINI_API_KEY=
ALT_GEMINI_KEY=

# رابط قاعدة البيانات - SQLite للمرحلة الأولى
DATABASE_URL=sqlite:///data/smartats.db

# بيئة التشغيل: development | production
APP_ENV=development

# مستوى تسجيل الأحداث: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# مفتاح سري لجلسات التطبيق (غيّره لاحقاً في الإنتاج)
SECRET_KEY=dev-secret-change-me


# إعدادات البريد (لإرسال كود استعادة كلمة المرور)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=learningosra@gmail.com
SMTP_PASSWORD=ljxt exee hqan aykq
SMTP_FROM=learningosra@gmail.com
SMTP_USE_TLS=true